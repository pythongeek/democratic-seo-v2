{
  "name": "open-seo-democratic",
  "version": "1.0.0",
  "description": "Democratic SEO — 100% free, open source alternative to Semrush and Ahrefs. No paid API dependencies.",
  "private": false,
  "license": "MIT",
  "author": "OpenSEO Community",
  "repository": {
    "type": "git",
    "url": "https://github.com/pythongeek/democratic-seo-v2.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "check:no-billing": "node scripts/check-no-billing.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scraper:install": "npx playwright install chromium",
    "scraper:heavy": "SCRAPER_MODE=heavy tsx src/scripts/scraper-worker.ts",
    "scraper:lightweight": "SCRAPER_MODE=lightweight tsx src/scripts/scraper-worker.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^1.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@neondatabase/serverless": "^0.10.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.0",
    "@upstash/redis": "^1.34.0",
    "ai": "^4.0.0",
    "better-auth": "^1.1.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.11.0",
    "geist": "^1.3.0",
    "hono": "^4.6.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.0",
    "playwright-core": "^1.49.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^9.0.0",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tldts": "^6.1.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
