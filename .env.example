# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL - Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Redis (Upstash or any Redis provider)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Auth (Better Auth)
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-long!!!"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google APIs (Optional — enhances data quality, but NOT required)
# Get from https://console.cloud.google.com
GOOGLE_API_KEY=""
# For Search Console integration (your own sites only)
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=""

# Bing API (Optional — enhances backlink discovery)
# Get from https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=""

# Scraper Mode (CRITICAL for Vercel compatibility)
# lightweight = fetch + cheerio (Vercel-safe, <10s)
# heavy = Playwright + Chromium (GitHub Actions / VPS only)
SCRAPER_MODE=lightweight

# Playwright (Optional — for local heavy mode or GitHub Actions)
# Path to Chromium executable (auto-detected if not set)
PLAYWRIGHT_CHROMIUM_PATH=""

# Cron Secret (for securing cron endpoints — used by cron-jobs.org AND GitHub Actions)
CRON_SECRET="your-cron-secret-random-string"

# Community / Governance
COMMUNITY_VOTE_THRESHOLD=10
GOVERNANCE_QUORUM=5
